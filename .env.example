YOUTUBE_API_KEY=your_api_key_here

# Optional: proxy for regions that need it
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

# Optional: custom database path
# YT_HISTORY_DB=youtube_history.db

# Optional: timezone for the quota day bucket. YouTube resets at midnight
# Pacific, so the default matches the real reset point.
# QUOTA_TIMEZONE=America/Los_Angeles

# Optional: cap on concurrent batch-scan / hot-category searches
# MAX_CONCURRENT_SCANS=8

# Optional: auto-snapshot tracked trend keywords every N hours (0 = disabled).
# Only keywords already in trend_tracking are touched.
# TREND_SNAPSHOT_INTERVAL_HOURS=24
# TREND_SNAPSHOT_MAX_KEYWORDS=10
